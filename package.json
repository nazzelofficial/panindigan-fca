{
  "name": "panindigan-fca",
  "version": "0.1.0",
  "description": "TypeScript library for Facebook Messenger bots on personal accounts",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:bench": "vitest bench",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14",
    "pnpm": ">=11.10.0"
  },
  "keywords": [
    "facebook",
    "messenger",
    "bot",
    "typescript",
    "fca",
    "appstate"
  ],
  "author": "Nazzel",
  "license": "MIT",
  "dependencies": {
    "@types/user-agents": "^1.0.4",
    "colorette": "^2.0.20",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "env-paths": "^4.0.0",
    "eventemitter3": "^5.0.4",
    "lru-cache": "^11.5.2",
    "mime-types": "^3.0.2",
    "p-queue": "^9.3.1",
    "p-retry": "^8.0.0",
    "p-throttle": "^8.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socks": "^2.8.9",
    "tough-cookie": "^6.0.2",
    "undici": "^8.7.0",
    "user-agents": "^2.1.116",
    "uuid": "^14.0.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.1",
    "@types/tough-cookie": "^4.0.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
