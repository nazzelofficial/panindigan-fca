{
  "name": "panindigan-fca",
  "version": "0.1.3",
  "description": "Modern TypeScript library for building Facebook Messenger bots using personal accounts.",
  "license": "MIT",
  "author": "Nazzel",
  "homepage": "https://github.com/nazzelofficial/panindigan-fca#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazzelofficial/panindigan-fca.git"
  },
  "bugs": {
    "url": "https://github.com/nazzelofficial/panindigan-fca/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nazzelofficial"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean",
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "build:dts": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:bench": "vitest bench",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "clean": "rimraf dist coverage",
    "prepublishOnly": "bun run typecheck && bun run build",
    "release": "bun run typecheck && bun run build && npm publish --access public"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "facebook",
    "facebook-messenger",
    "facebook-chat-api",
    "messenger",
    "chat",
    "bot",
    "automation",
    "fca",
    "typescript",
    "appstate",
    "mqtt",
    "messaging",
    "facebook-api",
    "facebook-bot",
    "messenger-bot"
  ],
  "dependencies": {
    "colorette": "^2.0.20",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "env-paths": "^4.0.0",
    "eventemitter3": "^5.0.4",
    "lru-cache": "^11.5.2",
    "mime-types": "^3.0.2",
    "p-queue": "^9.3.1",
    "p-retry": "^8.0.0",
    "p-throttle": "^8.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socks": "^2.8.9",
    "tough-cookie": "^6.0.2",
    "undici": "^8.7.0",
    "user-agents": "^2.1.116",
    "uuid": "^14.0.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.1",
    "@types/tough-cookie": "^4.0.5",
    "@types/user-agents": "^1.0.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}