# panindigan-fca environment variables
# All variables are optional unless otherwise noted.

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
PFCA_LOG_LEVEL=info
PFCA_LOG_PRETTY=false

# ------------------------------------------------------------------
# Storage
# Supported adapters:
#   remote (default) - Built-in Remote Storage API
#   file             - JSON file persistence
#   memory           - In-memory storage
#   redis            - Custom Redis StorageAdapter
# ------------------------------------------------------------------
PFCA_STORAGE_ADAPTER=remote

# File adapter
PFCA_SESSION_PERSIST_PATH=./panindigan-storage.json

# ------------------------------------------------------------------
# Remote Storage API (optional)
# These variables override the built-in Storage API endpoints.
# If omitted, the client automatically uses the built-in endpoints.
# ------------------------------------------------------------------
PFCA_STORAGE_API_URL=
PFCA_STORAGE_API_ENDPOINTS=
PFCA_STORAGE_API_AUTH_TOKEN=
PFCA_STORAGE_API_TIMEOUT_MS=10000
PFCA_STORAGE_API_RETRIES=2

# ------------------------------------------------------------------
# HTTP
# ------------------------------------------------------------------
PFCA_HTTP_MAX_CONNECTIONS=10
PFCA_HTTP_TIMEOUT_CONNECT=5000
PFCA_HTTP_TIMEOUT_REQUEST=30000
PFCA_HTTP_RETRIES_MAX=5
PFCA_HTTP_RETRIES_BASE_DELAY=500

# ------------------------------------------------------------------
# MQTT
# ------------------------------------------------------------------
PFCA_MQTT_RECONNECT_MAX=10
PFCA_MQTT_HEARTBEAT_INTERVAL=60000

# ------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------
PFCA_CACHE_TTL=300000
PFCA_CACHE_MAX_SIZE=500

# ------------------------------------------------------------------
# Stealth
# ------------------------------------------------------------------
PFCA_STEALTH_LEVEL=medium

# ------------------------------------------------------------------
# Proxy (optional)
# ------------------------------------------------------------------
PFCA_PROXY_URL=